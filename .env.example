# ============================================================
# AGRINEX DIGITAL AGRICULTURAL MARKETPLACE CONFIGURATION
# ============================================================
# Copy this file to .env and configure the variables.
# In local development mode, all external services have safe fallbacks:
# - If MONGO_URI is unset: AgriNex runs with in-memory persistence.
# - If GEMINI_API_KEY is unset: AI inspections route to MANUAL_REVIEW.
# - If GOOGLE_MAPS_API_KEY is unset: OSRM road routing engine is used.
# - If RAZORPAY is unset: Payments remain in PAYMENT_PENDING.
# - If RAZORPAYX is unset: Payouts remain in PAYOUT_PENDING.
# ============================================================

# Application Environment & Server Port
NODE_ENV=development
PORT=3000

# MongoDB Database Connection String (e.g., mongodb://localhost:27017/agrinex or Atlas URI)
# [REQUIRED FOR PRODUCTION]
MONGO_URI=

# JWT Secret Key for JSON Web Token signing & verification
# [REQUIRED FOR PRODUCTION]
JWT_SECRET=agrinex_super_secure_jwt_secret_change_in_production_2026

# Google Maps Platform API Key (Geocoding, Places Autocomplete, Routes API Directions v2)
# Backend key (used by server for distance calculations and address geocoding)
GOOGLE_MAPS_API_KEY=
# Frontend key (injected into browser for Places autocomplete widget and LiveMapModal)
VITE_GOOGLE_MAPS_API_KEY=

# Google OAuth 2.0 / OpenID Connect Credentials (for Real Sign in with Google)
# Generate from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Google Gemini Multimodal Vision API Key (for agricultural harvest video quality grading)
# Models used: gemini-2.5-flash
GEMINI_API_KEY=

# Razorpay Standard Checkout Credentials (for buyer payments & escrow lock)
# Generate from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# RazorpayX Corporate Payouts Credentials (for automated escrow release to farmers)
# Optional: If unconfigured, payouts remain safely marked as PAYOUT_PENDING
RAZORPAYX_ACCOUNT_NUMBER=
RAZORPAYX_KEY_ID=

# SMS Gateway (Fast2SMS or MSG91 for farmer OTP delivery)
# Optional: Set ENABLE_OTP_SIMULATOR=true in development to view OTPs directly in UI
SMS_API_KEY=
SMS_SENDER_ID=
ENABLE_OTP_SIMULATOR=true
